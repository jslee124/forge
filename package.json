{
  "name": "forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "biome check . && pnpm typecheck",
    "clean": "tsc -b --clean",
    "forge": "tsc -b && node apps/cli/dist/index.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
