{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "references": [
    { "path": "../../packages/auth" },
    { "path": "../../packages/codex-app-server" },
    { "path": "../../packages/config" },
    { "path": "../../packages/core" },
    { "path": "../../packages/model-deepseek" },
    { "path": "../../packages/model-compat" },
    { "path": "../../packages/model-openai" },
    { "path": "../../packages/persistence" },
    { "path": "../../packages/plugin-api" },
    { "path": "../../packages/resources" },
    { "path": "../../packages/tools" }
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
